# Copy to .env and fill in. Loaded automatically by `npm run dev` (Node --env-file-if-exists).

SESSION_SECRET=
# Needs a local Postgres with a "mixtape_party" database, migrated via `npm run migrate`.
# Postgres.app (https://postgresapp.com) works out of the box: trust auth, connect as your
# OS username, no password — DATABASE_URL below matches that default.
DATABASE_URL=postgres://localhost:5432/mixtape_party
PORT=3000

# Apple MusicKit identifier (developer.apple.com) — private key is the raw .p8 contents.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

# YouTube Music — session cookie for one app-owned music.youtube.com account, used for all
# users' playlist exports (copy the Cookie header from a logged-in browser session).
YOUTUBE_MUSIC_COOKIE=

# Resend (https://resend.com) — leave RESEND_API_KEY blank locally and outbound mail is a no-op.
# EMAIL_FROM must be on a verified sending domain, e.g. "Mixtape Party <no-reply@example.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Origin of the web client — where emailed password-reset and sign-in links point, and where the
# Google callback hands off its sign-in token.
APP_BASE_URL=http://localhost:8081

# Google sign-in (console.cloud.google.com → OAuth 2.0 Client ID, type "Web application").
# Leave blank and /auth/google/start answers 503 instead of sending anyone to Google.
# GOOGLE_REDIRECT_URI must be registered verbatim as an authorised redirect URI, and points at
# this API, not the web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
