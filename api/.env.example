# Copy to .env and fill in. Loaded automatically by `npm run dev` (Node --env-file-if-exists).

SESSION_SECRET=
# Needs a local Postgres with a "mixtape_party" database, migrated via `npm run migrate`.
# Postgres.app (https://postgresapp.com) works out of the box: trust auth, connect as your
# OS username, no password — DATABASE_URL below matches that default.
DATABASE_URL=postgres://localhost:5432/mixtape_party
PORT=3000

# Apple MusicKit identifier (developer.apple.com) — private key is the raw .p8 contents.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us
