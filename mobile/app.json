{
  "expo": {
    "name": "Mixtape Party",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "mixtapeparty",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mixtapeparty.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:mixtape-party.com",
        "applinks:mixtape-party.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5EEAD4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mixtapeparty.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mixtape-party.com",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "mixtape-party.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "mixtape-party.com",
              "pathPrefix": "/round"
            },
            {
              "scheme": "https",
              "host": "mixtape-party.com",
              "pathPrefix": "/league"
            },
            {
              "scheme": "https",
              "host": "mixtape-party.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFD93D",
          "imageWidth": 512,
          "android": {
            "imageWidth": 200
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mixtape Party uses your photo library so you can pick a profile photo."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "2d41ab93-1fc9-465e-b698-06ebe83890cb"
      }
    },
    "owner": "jamiwardlow"
  }
}
