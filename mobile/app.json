{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "mixtapeparty",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mixtapeparty.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "expo-audio",
      ["expo-image-picker", { "photosPermission": "Mixtape Party uses your photo library so you can pick a profile photo." }],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "2d41ab93-1fc9-465e-b698-06ebe83890cb"
      }
    },
    "owner": "jamiwardlow"
  }
}
